# Dockerfile for FreeRTOS Build Environment (x86-64 with Veracode CLI)
#
# Usage:
#   docker build --platform linux/amd64 -t freertos-builder:x86-64 -f Dockerfile.x86-64 .
#   docker run -it -v $(pwd):/home/builder/project freertos-builder:x86-64
#
# Based on: Ubuntu 22.04 LTS
# Includes: Veracode CLI for SAST packaging (x86-64 only)
#
# Architecture note: This is a separate image from the base Dockerfile because
# Veracode CLI is only available for x86-64 architecture. Use this image for:
#   - x86-64 builds with veracode package/upload support
#   - Manual testing via CONTAINER_MANAGER.sh with x86-64 architecture
# For ARM64 builds, use the base Dockerfile (freertos-builder:arm64)

FROM ubuntu:22.04

LABEL maintainer="FreeRTOS Build Team"
LABEL description="FreeRTOS x86-64 build and SAST scanning environment"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# ===== INSTALL DEPENDENCIES =====
RUN apt-get update && apt-get install -y \
    # Native compiler
    gcc \
    g++ \
    binutils \
    \
    # Build tools
    cmake \
    build-essential \
    make \
    autoconf \
    automake \
    libtool \
    \
    # Development utilities
    git \
    curl \
    wget \
    ca-certificates \
    \
    # SAST scanning
    jq \
    python3 \
    python3-pip \
    \
    # Diagnostics
    file \
    gdb \
    \
    && rm -rf /var/lib/apt/lists/*

# ===== INSTALL VERACODE CLI =====
# Note: Installation may fail in some environments; marked as non-fatal
RUN curl -fsS https://tools.veracode.com/veracode-cli/install | sh || true
# Fix permissions to allow non-root user execution (chmod 755)
RUN chmod 755 /veracode 2>/dev/null || true

# ===== CREATE NON-ROOT USER =====
RUN useradd -m -s /bin/bash -u 1000 builder && \
    mkdir -p /home/builder/project && \
    chown -R builder:builder /home/builder

# ===== SETUP ENVIRONMENT =====
COPY freertos-env.sh /opt/
RUN chmod +x /opt/freertos-env.sh

WORKDIR /home/builder/project

USER builder

CMD ["/bin/bash"]
